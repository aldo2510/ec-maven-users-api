pipeline {
  agent { label 'controller' }

  environment {
    APP_NAME         = 'mi-application'
    AWS_REGION       = 'us-east-1'

    ECR_ACCOUNT_ID   = '<AWS_ACCOUNT_ID>'
    ECR_REPOSITORY   = 'mi-application'
    ECR_REGISTRY     = "${ECR_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    IMAGE_NAME       = "${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

    // ARN del servicio creado una sola vez con ECS Express Mode.
    ECS_EXPRESS_SERVICE_ARN = '<ECS_EXPRESS_SERVICE_ARN>'

    AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
    AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
  }

  options { timestamps() }

  stages {
    stage('Build con Maven') {
      agent { docker { image 'maven:3.9.6-eclipse-temurin-17' } }
      steps {
        sh '''
          set -eux
          mvn -v
          mvn clean package -DskipTests
        '''
        archiveArtifacts artifacts: 'target/*.jar', fingerprint: true, onlyIfSuccessful: true
        stash name: 'app-jar', includes: 'target/*.jar'
      }
    }

    stage('Docker Build & Push a ECR (main)') {
      when {
        expression {
          def b = (env.BRANCH_NAME ?: env.GIT_BRANCH ?: '').trim()
          b == 'main' || b == 'origin/main' || b == 'refs/heads/main' || b.endsWith('/main')
        }
      }
      agent {
        docker {
          image 'docker:24-cli'
          args '-v /var/run/docker.sock:/var/run/docker.sock -u 0:0'
        }
      }
      steps {
        script {
          try {
            copyArtifacts(
              projectName: env.JOB_NAME,
              selector: [$class: 'SpecificBuildSelector', buildNumber: "${env.BUILD_NUMBER}"],
              filter: 'target/*.jar',
              fingerprintArtifacts: true,
              flatten: true,
              target: 'target'
            )
            echo 'copyArtifacts OK'
          } catch (err) {
            echo "copyArtifacts no disponible (${err}); usando fallback unstash"
            unstash 'app-jar'
          }
        }

        sh '''
          set -eux
          apk add --no-cache aws-cli
          aws --version
          export AWS_DEFAULT_REGION="$AWS_REGION"

          aws ecr describe-repositories             --repository-names "$ECR_REPOSITORY"             >/dev/null 2>&1 ||           aws ecr create-repository             --repository-name "$ECR_REPOSITORY"

          aws ecr get-login-password --region "$AWS_REGION" |
            docker login --username AWS --password-stdin "$ECR_REGISTRY"

          docker build -t "$IMAGE_NAME" .
          docker push "$IMAGE_NAME"

          echo "Imagen publicada: $IMAGE_NAME"
        '''
      }
    }

    stage('Deploy a ECS Express Mode (main)') {
      when {
        expression {
          def b = (env.BRANCH_NAME ?: env.GIT_BRANCH ?: '').trim()
          b == 'main' || b == 'origin/main' || b == 'refs/heads/main' || b.endsWith('/main')
        }
      }
      agent {
        docker {
          image 'amazon/aws-cli:2'
          args '-u 0:0'
        }
      }
      steps {
        sh '''
          set -eux
          export AWS_DEFAULT_REGION="$AWS_REGION"

          echo "Iniciando nuevo deployment de ECS Express Mode..."

          CLUSTER_ARN=$(aws ecs describe-services             --service "$ECS_EXPRESS_SERVICE_ARN"             --query 'services[0].cluster'             --output text)

          aws ecs update-service             --cluster "$CLUSTER_ARN"             --service "$ECS_EXPRESS_SERVICE_ARN"             --force-new-deployment

          aws ecs describe-services             --service "$ECS_EXPRESS_SERVICE_ARN"             --query 'services[0].{status:status,desired:desiredCount,running:runningCount,pending:pendingCount}'             --output table

          echo "Deployment solicitado correctamente."
        '''
      }
    }
  }

  post {
    success {
      echo 'OK: Maven, ECR y ECS Express Mode.'
    }
    failure {
      echo 'ERROR en el pipeline.'
    }
  }
}